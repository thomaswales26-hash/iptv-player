if(NOT APPLE)
    message(FATAL_ERROR "The FFmpeg dependency bundler only supports macOS.")
endif()

if(NOT DEFINED OUTPUT_DIR OR NOT DEFINED FFMPEG_SOURCE OR NOT DEFINED FFPLAY_SOURCE)
    message(FATAL_ERROR "OUTPUT_DIR, FFMPEG_SOURCE, and FFPLAY_SOURCE are required.")
endif()

set(LIBRARY_DIR "${OUTPUT_DIR}/../Frameworks")
file(REMOVE_RECURSE "${LIBRARY_DIR}")
file(MAKE_DIRECTORY "${LIBRARY_DIR}")

function(run_checked)
    execute_process(COMMAND ${ARGV}
        RESULT_VARIABLE result
        OUTPUT_VARIABLE output
        ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}${error}")
    endif()
endfunction()

function(resolve_dependency image dependency output_variable)
    if(dependency MATCHES "^(/System/Library/|/usr/lib/)")
        set(${output_variable} "" PARENT_SCOPE)
        return()
    endif()

    set(candidates)
    if(IS_ABSOLUTE "${dependency}")
        list(APPEND candidates "${dependency}")
    elseif(dependency MATCHES "^@loader_path(/.*)?$")
        string(REGEX REPLACE "^@loader_path/?" "" suffix "${dependency}")
        get_filename_component(image_dir "${image}" DIRECTORY)
        list(APPEND candidates "${image_dir}/${suffix}")
    elseif(dependency MATCHES "^@executable_path(/.*)?$")
        string(REGEX REPLACE "^@executable_path/?" "" suffix "${dependency}")
        list(APPEND candidates "${OUTPUT_DIR}/${suffix}")
    elseif(dependency MATCHES "^@rpath/(.+)$")
        set(suffix "${CMAKE_MATCH_1}")
        execute_process(COMMAND otool -l "${image}"
            RESULT_VARIABLE result
            OUTPUT_VARIABLE load_commands
            ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "otool failed for ${image}: ${error}")
        endif()
        string(REPLACE "\n" ";" load_command_lines "${load_commands}")
        set(runpaths)
        foreach(line IN LISTS load_command_lines)
            if(line MATCHES "^[ \t]*path (.+) \\(offset [0-9]+\\)$")
                set(runpath "${CMAKE_MATCH_1}")
                if(runpath MATCHES "^@loader_path(/.*)?$")
                    string(REGEX REPLACE "^@loader_path/?" "" runpath_suffix "${runpath}")
                    get_filename_component(image_dir "${image}" DIRECTORY)
                    list(APPEND runpaths "${image_dir}/${runpath_suffix}")
                elseif(runpath MATCHES "^@executable_path(/.*)?$")
                    string(REGEX REPLACE "^@executable_path/?" "" runpath_suffix "${runpath}")
                    list(APPEND runpaths "${OUTPUT_DIR}/${runpath_suffix}")
                elseif(IS_ABSOLUTE "${runpath}")
                    list(APPEND runpaths "${runpath}")
                endif()
            endif()
        endforeach()

        foreach(runpath IN LISTS runpaths)
            list(APPEND candidates "${runpath}/${suffix}")
        endforeach()
    else()
        message(FATAL_ERROR "Unsupported dependency path '${dependency}' in ${image}")
    endif()

    foreach(candidate IN LISTS candidates)
        if(EXISTS "${candidate}")
            file(REAL_PATH "${candidate}" resolved)
            set(${output_variable} "${resolved}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Could not resolve '${dependency}' referenced by ${image}")
endfunction()

function(add_required_rpath image rpath)
    execute_process(COMMAND otool -l "${image}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE load_commands
        ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "otool failed for ${image}: ${error}")
    endif()

    string(FIND "${load_commands}" "path ${rpath} (offset" rpath_position)
    if(NOT rpath_position EQUAL -1)
        return()
    endif()
    run_checked(install_name_tool -add_rpath "${rpath}" "${image}")
endfunction()

function(remove_other_rpaths image required_rpath)
    execute_process(COMMAND otool -l "${image}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE load_commands
        ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "otool failed for ${image}: ${error}")
    endif()

    string(REPLACE "\n" ";" load_command_lines "${load_commands}")
    set(expect_rpath FALSE)
    foreach(line IN LISTS load_command_lines)
        if(line MATCHES "^[ \t]*cmd LC_RPATH$")
            set(expect_rpath TRUE)
        elseif(expect_rpath)
            set(expect_rpath FALSE)
            if(line MATCHES "^[ \t]*path (.+) \\(offset [0-9]+\\)$")
                set(rpath "${CMAKE_MATCH_1}")
                if(NOT "${rpath}" STREQUAL "${required_rpath}")
                    run_checked(install_name_tool -delete_rpath "${rpath}" "${image}")
                endif()
            endif()
        endif()
    endforeach()
endfunction()

function(bundle_image image is_library)
    execute_process(COMMAND otool -L "${image}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE dependencies
        ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "otool failed for ${image}: ${error}")
    endif()

    string(REPLACE "\n" ";" dependency_lines "${dependencies}")
    foreach(line IN LISTS dependency_lines)
        if(NOT line MATCHES "^[ \t]+(.+) \\(compatibility version [0-9.]+, current version [0-9.]+\\)$")
            continue()
        endif()
        set(dependency "${CMAKE_MATCH_1}")
        if(is_library)
            get_filename_component(image_name "${image}" NAME)
            if(dependency STREQUAL "@rpath/${image_name}")
                continue()
            endif()
        endif()
        resolve_dependency("${image}" "${dependency}" resolved)
        if(resolved STREQUAL "")
            continue()
        endif()

        string(SHA256 dependency_hash "${resolved}")
        string(SUBSTRING "${dependency_hash}" 0 12 short_hash)
        get_filename_component(dependency_filename "${resolved}" NAME)
        string(SHA256 filename_key "${dependency_filename}")
        get_property(filename_owner GLOBAL PROPERTY "BUNDLE_NAME_${filename_key}")
        if(filename_owner AND NOT "${filename_owner}" STREQUAL "${resolved}")
            set(bundle_name "${dependency_filename}-${short_hash}")
        else()
            set(bundle_name "${dependency_filename}")
            set_property(GLOBAL PROPERTY "BUNDLE_NAME_${filename_key}" "${resolved}")
        endif()
        get_property(bundled GLOBAL PROPERTY "BUNDLED_${dependency_hash}")
        if(NOT bundled)
            set(bundle_path "${LIBRARY_DIR}/${bundle_name}")
            set_property(GLOBAL PROPERTY "BUNDLED_${dependency_hash}" "${bundle_path}")
            run_checked("${CMAKE_COMMAND}" -E copy "${resolved}" "${bundle_path}")
            run_checked(install_name_tool -id "@rpath/${bundle_name}" "${bundle_path}")
            bundle_image("${bundle_path}" TRUE)
        else()
            set(bundle_path "${bundled}")
        endif()

        run_checked(install_name_tool -change "${dependency}" "@rpath/${bundle_name}" "${image}")
    endforeach()

    if(is_library)
        add_required_rpath("${image}" "@loader_path")
    else()
        add_required_rpath("${image}" "@executable_path/../Frameworks")
    endif()
    if(is_library)
        remove_other_rpaths("${image}" "@loader_path")
    else()
        remove_other_rpaths("${image}" "@executable_path/../Frameworks")
    endif()
    run_checked(codesign --force --sign - --timestamp=none "${image}")
endfunction()

foreach(tool IN ITEMS ffmpeg ffplay)
    set(source "${FFMPEG_SOURCE}")
    if(tool STREQUAL "ffplay")
        set(source "${FFPLAY_SOURCE}")
    endif()
    set(destination "${OUTPUT_DIR}/${tool}")
    run_checked("${CMAKE_COMMAND}" -E copy "${source}" "${destination}")
    bundle_image("${destination}" FALSE)
endforeach()

if(DEFINED SDL3_SOURCE AND NOT SDL3_SOURCE STREQUAL "")
    set(sdl3_bundle "${LIBRARY_DIR}/libSDL3.dylib")
    run_checked("${CMAKE_COMMAND}" -E copy "${SDL3_SOURCE}" "${sdl3_bundle}")
    run_checked(install_name_tool -id "@rpath/libSDL3.dylib" "${sdl3_bundle}")
    bundle_image("${sdl3_bundle}" TRUE)
endif()
